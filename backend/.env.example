APP_NAME=CommuApp
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

CACHE_STORE=redis

LIGHTHOUSE_QUERY_CACHE_MODE=opcache

NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT=

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_DB=1
REDIS_CACHE_CONNECTION=cache

GEOCODE_CACHE_TTL_SECONDS=2592000
SUMMARY_CACHE_TTL_SECONDS=1800
NOTICE_BATCH_CACHE_TTL_SECONDS=300

COMMU_GRAPHQL_URL=https://office.commuapp.fi/graphql
COMMU_BEARER_TOKEN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=eu.amazon.nova-2-lite-v1:0
BEDROCK_AWS_REGION=eu-north-1
SUMMARY_NOTICE_BATCH_COUNT=30
SUMMARY_MIN_NOTICES=3
